# Local Supabase Edge Function secrets for `s3-storage`.
# For production, configure these in Supabase Dashboard > Edge Functions > Secrets.
# Never use real credentials in this tracked example file.
S3_BUCKET=your-private-s3-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-restricted-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-restricted-iam-secret-access-key
