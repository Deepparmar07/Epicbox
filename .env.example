# EpicBox frontend (Vite). Copy to .env and set your Supabase project values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy name supported for existing deployments:
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# S3 is the primary object-storage provider for new uploads.
VITE_STORAGE_PROVIDER=s3

# Keep this identical across local and Vercel environments when
# existing encrypted files must remain readable.
VITE_ENCRYPTION_KEY=your-existing-encryption-key

# S3 bucket and AWS credentials are server-side Edge Function settings.
# See supabase/functions/.env.example for local development configuration.
# Never add AWS credentials here, to Vercel frontend variables, or to VITE_*.
